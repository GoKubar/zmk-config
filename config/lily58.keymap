/*
 * Lily58 — Gallium Colstag / Programmer / Vim
 *
 * Design goals:
 * - Preserve Gallium's alpha + base punctuation positions
 * - Preserve useful Lily58 physical keys instead of forcing a 36-key layout
 * - Dedicated thumb Space / Backspace / Enter
 * - Dedicated modifiers; no HRMs initially
 * - NAV with arrows on physical QWERTY H/J/K/L
 * - Programming symbols + right-hand numpad
 * - Explicit optional delimiter-pair macros
 * - Tri-layer FN with Bluetooth/F/media controls
 * - Plain QWERTY gaming layer with no layer-tap leakage
 * - Preserve rotary encoder volume on every layer
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define FN   3
#define GAME 4

/ {
    macros {
        /*
         * Convenience pair macros. Individual delimiters remain available.
         * These emit opener + closer + Left, e.g. () then cursor inside.
         * In Neovim with an autopairs plugin, use the individual opener unless
         * you deliberately want the keyboard macro.
         */
        pair_paren: pair_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };

        pair_bracket: pair_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };

        pair_brace: pair_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
        };

        pair_angle: pair_angle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LT &kp GT &kp LEFT>;
        };
    };

    /*
     * SYM + NAV -> FN. FN is a higher layer than either input layer, as ZMK's
     * conditional-layer design expects.
     */
    conditional_layers {
        compatible = "zmk,conditional-layers";

        sym_nav_fn {
            if-layers = <SYM NAV>;
            then-layer = <FN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * BASE — Gallium Colstag
         *
         * |  `  | 1 | 2 | 3 | 4 | 5 |                 | 6 | 7 | 8 | 9 | 0 | - |
         * | TAB | B | L | D | C | V |                 | J | Y | O | U | , | \ |
         * | ESC | N | R | T | S | G |                 | P | H | A | E | I | / |
         * | SFT | X | Q | M | W | Z | [ |         | ] | K | F | ' | ; | . |SFT|
         *                    |CTL|SYM|ALT|SPC|     |BSP|ENT|NAV|GUI|
         *
         * Notes:
         * - / is kept in Gallium's base punctuation block.
         * - Enter moves from the outer pinky column to a right thumb.
         * - [] remain on the Lily's inner keys as secondary direct access;
         *   they are also represented in the symbol system.
         */
        base_layer {
            display-name = "Gallium";
            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3     &kp N4  &kp N5                                    &kp N6         &kp N7  &kp N8          &kp N9   &kp N0    &kp MINUS
&kp TAB     &kp B   &kp L   &kp D      &kp C   &kp V                                     &kp J          &kp Y   &kp O           &kp U    &kp COMMA &kp BSLH
&kp ESCAPE  &kp N   &kp R   &kp T      &kp S   &kp G                                     &kp P          &kp H   &kp A           &kp E    &kp I     &kp FSLH
&kp LSHFT   &kp X   &kp Q   &kp M      &kp W   &kp Z         &kp LBKT     &kp RBKT       &kp K          &kp F   &kp SQT         &kp SEMI &kp DOT   &kp RSHFT
                            &kp LCTRL  &mo SYM &kp LEFT_ALT  &kp SPACE    &kp BACKSPACE  &kp ENTER       &mo NAV &kp RIGHT_META
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * SYM — programming symbols + right-hand numpad.
         *
         * Left hand prioritizes common code/Vim symbols. Right hand is a numpad.
         * $ and % stay on easy top-row positions because they are used regularly
         * in Vim. Common programming punctuation is kept direct and unshifted.
         * The two inner Lily keys become {} on this layer, making:
         *   BASE inner keys = []
         *   SYM  inner keys = {}
         * while () are direct on the right home row.
         *
         * Pair macros occupy otherwise low-value number-row positions.
         */

        symbol_layer {
            display-name = "Symbols";
            bindings = <
&kp GRAVE   &kp TILDE  &kp EXCL   &kp AT      &kp DOLLAR &kp PRCNT                         &kp CARET      &kp AMPS        &pair_paren    &pair_bracket &pair_brace &pair_angle
&kp BSLH    &kp PIPE   &kp AMPS   &kp STAR    &kp QMARK  &kp HASH                          &kp N7         &kp N8          &kp N9         &kp FSLH       &kp STAR   &kp MINUS
&trans      &kp HASH   &kp DQT    &kp SQT     &kp MINUS  &kp EQUAL                         &kp N4         &kp N5          &kp N6         &kp PLUS       &kp LPAR   &kp RPAR
&trans      &kp LT     &kp GT     &kp UNDER   &kp COLON  &kp SEMI      &kp LBRC   &kp RBRC &kp N1         &kp N2          &kp N3         &kp N0         &kp DOT    &trans
                               &trans       &trans       &trans        &trans       &trans           &trans           &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * NAV — hold the right-thumb NAV key.
         *
         * Right-hand home-row QWERTY H/J/K/L physical positions:
         *     LEFT  DOWN  UP  RIGHT
         *
         * Opposite-hand home row:
         *     GUI   ALT   CTRL SHIFT
         *
         * This makes modifier+arrow operations comfortable while leaving
         * semantic Vim commands entirely stock.
         */
        nav_layer {
            display-name = "Navigation";
            bindings = <
&trans      &trans        &trans       &trans      &trans         &trans                       &trans       &trans         &trans         &trans        &trans       &trans
&kp TAB     &kp HOME      &kp PG_DN    &kp PG_UP   &kp END        &kp INSERT                   &kp HOME     &kp PG_DN      &kp PG_UP      &kp END       &kp DELETE  &kp BSLH
&kp ESCAPE  &kp LEFT_GUI  &kp LEFT_ALT &kp LCTRL   &kp LSHFT      &kp BACKSPACE                &kp LEFT     &kp DOWN       &kp UP_ARROW   &kp RIGHT      &kp ENTER   &kp DELETE
&trans      &kp LC(Z)     &kp LC(X)    &kp LC(C)   &kp LC(V)     &kp ESCAPE     &trans  &trans &trans       &kp HOME       &kp PG_DN      &kp PG_UP       &kp END     &trans
                                &trans        &trans      &trans         &trans     &trans        &trans        &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * FN — active only while SYM + NAV are held.
         *
         * Core functionality preserved from the original keymap:
         *   BT clear + all five BT profiles
         *   F1-F12
         *   encoder volume
         *
         * Added useful media/brightness controls and the GAME toggle.
         * BT_CLR remains behind a deliberate three-key chord, reducing the
         * chance of accidentally erasing the current bond.
         */
        function_layer {
            display-name = "Function";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4              &kp C_PREV    &kp C_PP      &kp C_NEXT     &kp C_MUTE     &kp C_VOL_DN   &kp C_VOL_UP
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                    &kp F7        &kp F8        &kp F9         &kp F10        &kp F11        &kp F12
&trans      &trans        &trans        &trans        &trans        &trans                     &kp C_BRI_DN  &kp C_BRI_UP  &kp C_VOL_DN   &kp C_VOL_UP   &kp C_MUTE     &trans
&trans      &trans        &trans        &trans        &trans        &trans       &tog GAME     &tog GAME    &trans        &trans         &trans         &trans         &trans       &trans
                                       &trans       &trans       &trans          &trans         &trans         &trans        &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * GAME — plain QWERTY + physical number row.
         *
         * No &trans on the former SYM/NAV thumb positions: those positions are
         * ordinary modifiers instead, so holding them cannot accidentally
         * activate typing layers mid-game.
         *
         * Either inner key exits GAME.
         */
        game_layer {
            display-name = "Game";
            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3     &kp N4  &kp N5                                    &kp N6       &kp N7  &kp N8    &kp N9    &kp N0    &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E      &kp R   &kp T                                     &kp Y        &kp U   &kp I     &kp O     &kp P     &kp BSLH
&kp ESCAPE  &kp A   &kp S   &kp D      &kp F   &kp G                                     &kp H        &kp J   &kp K     &kp L     &kp SEMI  &kp ENTER
&kp LSHFT   &kp Z   &kp X   &kp C      &kp V   &kp B         &tog GAME     &tog GAME     &kp N        &kp M   &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                            &kp LCTRL  &kp LEFT_GUI &kp LEFT_ALT &kp SPACE &kp BACKSPACE &kp RIGHT_ALT &kp RCTRL &kp RIGHT_META
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
