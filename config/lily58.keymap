/*
 * Lily58 — QWERTY / Corne-style Programmer / Vim
 *
 * Design goals:
 * - Standard QWERTY alphas for maximum cross-device fluency
 * - Corne-style 3x5 symbol/navigation philosophy; Lily58 extras are conveniences
 * - Dedicated thumb Space / Backspace / Enter
 * - Dedicated modifiers; no HRMs initially
 * - NAV with arrows on physical QWERTY H/J/K/L
 * - Programming symbols + right-hand numpad with no dependence on the number row
 * - Delimiter pairs arranged symmetrically on the symbol layer
 * - Tri-layer FN with Bluetooth/F/media controls
 * - Plain QWERTY gaming layer with no layer-tap leakage
 * - Preserve rotary encoder volume on every layer
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define FN   3
#define GAME 4

/ {
    /*
     * SYM + NAV -> FN. FN is a higher layer than either input layer, as ZMK's
     * conditional-layer design expects.
     */

    conditional_layers {
        compatible = "zmk,conditional-layers";

        sym_nav_fn {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * BASE — standard QWERTY
         *
         * |  `  | 1 | 2 | 3 | 4 | 5 |                 | 6 | 7 | 8 | 9 | 0 | - |
         * | TAB | Q | W | E | R | T |                 | Y | U | I | O | P | \ |
         * | ESC | A | S | D | F | G |                 | H | J | K | L | ; | / |
         * | SFT | Z | X | C | V | B | [ |         | ] | N | M | , | . | ' |SFT|
         *                    |CTL|SYM|ALT|SPC|     |BSP|ENT|NAV|GUI|
         *
         * Notes:
         * - Enter moves from the outer pinky column to a right thumb.
         * - [] remain on the Lily inner keys as bonus direct access; SYM also
         *   provides them, so the symbol system does not depend on those extras.
         */

        base_layer {
            display-name = "QWERTY";
            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3        &kp N4  &kp N5                                            &kp N6     &kp N7  &kp N8          &kp N9   &kp N0     &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E         &kp R   &kp T                                             &kp Y      &kp U   &kp I           &kp O    &kp P      &kp BSLH
&kp ESCAPE  &kp A   &kp S   &kp D         &kp F   &kp G                                             &kp H      &kp J   &kp K           &kp L    &kp SEMI   &kp SQT
&kp LSHFT   &kp Z   &kp X   &kp C         &kp V   &kp B      &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp N      &kp M   &kp COMMA       &kp DOT  &kp SLASH  &kp RSHFT
                            &kp LEFT_ALT  &mo 2   &kp LCTRL  &kp SPACE           &kp BACKSPACE      &kp ENTER  &mo 1   &kp RIGHT_META
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * SYM — Corne-style programmer symbols + right-hand numpad.
         *
         * Design borrowed from proven Corne patterns:
         * - ! @ # $ % live on the left alpha top row (no 1u shift).
         * - # and * are vertically paired, useful for Vim search navigation.
         * - -/= and _ are kept direct rather than hidden behind combos.
         * - Right hand is a memorable numpad.
         * - Delimiters are symmetric: [] on outer top, {} outer home,
         *   <> outer bottom, () on the Lily inner keys.
         * - The physical Lily58 number row is transparent here, so it remains
         *   usable for digits while SYM is held; SYM never depends on it.
         *
         *  [ | !  @  #  $  %                  7  8  9  /  * | ]
         *  { | ^  &  *  -  =                  4  5  6  +  - | }
         *  < | ~  `  \  |  _ | (          ) | 1  2  3  0  . | >
         */

        symbol_layer {
            display-name = "Symbols";
            bindings = <
&trans    &trans     &trans         &trans                &trans                 &trans                                            &trans  &trans  &trans  &trans        &trans     &trans
&kp LBKT  &kp EXCL   &kp AT         &kp HASH              &kp DOLLAR             &kp PRCNT                                         &kp N7  &kp N8  &kp N9  &kp ASTERISK  &kp SLASH  &kp RBKT
&kp LBRC  &kp CARET  &kp AMPERSAND  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL                                         &kp N4  &kp N5  &kp N6  &kp PLUS      &kp MINUS  &kp RBRC
&kp LT    &kp TILDE  &kp GRAVE      &kp BSLH              &kp PIPE               &kp UNDER  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp N1  &kp N2  &kp N3  &kp N0        &kp DOT    &kp GT
                                    &trans                &trans                 &trans     &trans              &trans             &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * NAV — hold the right-thumb NAV key.
         *
         * Right-hand home-row QWERTY H/J/K/L physical positions:
         *     LEFT  DOWN  UP  RIGHT
         *
         * Opposite-hand home row:
         *     GUI   ALT   CTRL SHIFT
         *
         * This makes modifier+arrow operations comfortable while leaving
         * semantic Vim commands entirely stock.
         */

        nav_layer {
            display-name = "Navigation";
            bindings = <
&trans      &trans        &trans        &trans     &trans     &trans                               &trans    &trans     &trans        &trans     &trans      &trans
&kp TAB     &kp HOME      &kp PG_DN     &kp PG_UP  &kp END    &kp INSERT                           &kp HOME  &kp PG_DN  &kp PG_UP     &kp END    &kp DELETE  &kp BSLH
&kp ESCAPE  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &kp BACKSPACE                        &kp LEFT  &kp DOWN   &kp UP_ARROW  &kp RIGHT  &kp ENTER   &kp DELETE
&trans      &kp LC(Z)     &kp LC(X)     &kp LC(C)  &kp LC(V)  &kp ESCAPE     &trans    &trans      &trans    &kp HOME   &kp PG_DN     &kp PG_UP  &kp END     &trans
                                        &trans     &trans     &trans         &trans    &kp DELETE  &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * FN — active only while SYM + NAV are held.
         *
         * Core functionality preserved from the original keymap:
         *   BT clear + all five BT profiles
         *   F1-F12
         *   encoder volume
         *
         * Added useful media/brightness controls and the GAME toggle.
         * BT_CLR remains behind a deliberate three-key chord, reducing the
         * chance of accidentally erasing the current bond.
         */

        function_layer {
            display-name = "Function";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                          &kp F7        &kp F8        &kp F9        &kp F10       &kp F11       &kp F12
&trans      &trans        &trans        &trans        &trans        &trans                          &kp C_BRI_DN  &kp C_BRI_UP  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE    &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans        &trans        &trans        &trans        &trans        &trans
                                        &trans        &trans        &trans        &trans    &trans  &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * GAME — plain QWERTY + physical number row.
         *
         * No &trans on the former SYM/NAV thumb positions: those positions are
         * ordinary modifiers instead, so holding them cannot accidentally
         * activate typing layers mid-game.
         *
         * Either inner key exits GAME.
         */
    };
};
